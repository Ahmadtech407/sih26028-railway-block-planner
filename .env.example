# ==============================================================================
# Indian Railways AI Section Controller & Passenger Experience (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. External Rail API Credentials (Server-Side Only - Never Exposed to Clients)
# ------------------------------------------------------------------------------
# Primary Railway API Key (RapidAPI IRCTC, CRIS, or data.gov.in)
# If using RapidAPI (e.g., IRCTC Indian Railway Live Train / Live Status):
RAIL_API_KEY=

# Railway API Provider: RAPIDAPI_IRCTC | CRIS_NTES | DATA_GOV_IN | RTIS_GPS
RAIL_API_PROVIDER=RAPIDAPI_IRCTC

# Optional custom API endpoint override
RAIL_API_URL=https://irctc1.p.rapidapi.com/api/v1/liveTrainStatus

# RapidAPI Host header (default: irctc1.p.rapidapi.com)
RAPIDAPI_HOST=irctc1.p.rapidapi.com

# Alternate / Specific API Keys (optional fallbacks)
RAPIDAPI_KEY=
CRIS_API_KEY=
DATA_GOV_IN_API_KEY=

# ------------------------------------------------------------------------------
# 2. Open-Meteo & Weather Intelligence (Free Public Meteorological Service)
# ------------------------------------------------------------------------------
# Optional commercial Open-Meteo API key (leave blank for free tier)
OPEN_METEO_API_KEY=

# ------------------------------------------------------------------------------
# 3. Supabase Cloud Database (Train Telemetry, History & Platform Reassignments)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 4. Server Networking
# ------------------------------------------------------------------------------
FASTAPI_PORT=8000
STREAMLIT_PORT=8501
